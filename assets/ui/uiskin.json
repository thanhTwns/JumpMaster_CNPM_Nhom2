{
  "com.badlogic.gdx.graphics.Color": {
    "white":     { "r": 1,    "g": 1,    "b": 1,    "a": 1 },
    "black":     { "r": 0,    "g": 0,    "b": 0,    "a": 1 },
    "red":       { "r": 0.91, "g": 0.27, "b": 0.37, "a": 1 },
    "darkbg":    { "r": 0.1,  "g": 0.1,  "b": 0.18, "a": 1 },
    "outline":   { "r": 0.91, "g": 0.27, "b": 0.37, "a": 1 },
    "purple":    { "r": 0.5,  "g": 0.47, "b": 0.87, "a": 1 }
  },

  "com.badlogic.gdx.graphics.g2d.BitmapFont": {
    "default-font": { "file": "default.fnt" }
  },

  "com.badlogic.gdx.scenes.scene2d.ui.Label$LabelStyle": {
    "default": {
      "font": "default-font",
      "fontColor": "white"
    },
    "title": {
      "font": "default-font",
      "fontColor": "red"
    },
    "subtitle": {
      "font": "default-font",
      "fontColor": "white"
    }
  },

  "com.badlogic.gdx.scenes.scene2d.ui.TextButton$TextButtonStyle": {
    "default": {
      "font": "default-font",
      "fontColor": "white",
      "up":   { "type": "NinePatchDrawable", "region": "button" },
      "down": { "type": "NinePatchDrawable", "region": "button-pressed" }
    },
    "classic": {
      "font": "default-font",
      "fontColor": "white",
      "up":   { "type": "NinePatchDrawable", "region": "button-red" },
      "down": { "type": "NinePatchDrawable", "region": "button-red-pressed" }
    },
    "outline": {
      "font": "default-font",
      "fontColor": "outline",
      "up":   { "type": "NinePatchDrawable", "region": "button-outline" },
      "down": { "type": "NinePatchDrawable", "region": "button-outline-pressed" }
    }
  }
}
